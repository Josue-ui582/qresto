# Environnement applicatif : development, staging ou production
APP_ENV=
# URL PostgreSQL poolée Neon pour les connexions de l'application
DATABASE_URL=
# URL PostgreSQL directe Neon pour les migrations
DIRECT_URL=
# Clé aléatoire d'au moins 32 caractères pour signer les sessions
JWT_SECRET=
# Origine publique de l'application (ex. https://qresto.vercel.app)
NEXT_PUBLIC_APP_URL=
# Stockage des images : local en développement, cloudinary en staging/production
STORAGE_PROVIDER=
# Répertoire local facultatif, uniquement en développement
UPLOADS_DIRECTORY=
# Identifiants API Cloudinary requis avec STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Fournisseurs simulés par défaut ; valeurs possibles : simulated, real
WHATSAPP_PROVIDER=
PAYMENT_PROVIDER=
# Autorise explicitement le démarrage staging si un fournisseur est configuré en real
ALLOW_REAL_PROVIDERS_IN_STAGING=
# Mot de passe du compte restaurateur créé par le seed staging
DEMO_OWNER_PASSWORD=
# Adresse e-mail facultative du compte restaurateur créé par le seed staging
DEMO_OWNER_EMAIL=

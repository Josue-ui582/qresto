generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  DELIVERY_PARTNER
}

enum StaffRole {
  MANAGER
  CHEF
  WAITER
  CASHIER
  DELIVERY
}

enum SubscriptionPlan {
  FREE
  STARTER_5000
  PRO_8000
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MTN_MOMO
  MOOV_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
}

enum Model3DType {
  poulet_braise
  poisson_grille
  igname_pile
  burger
  alloco
  cocktail
}

// ==========================================
// MODELS
// ==========================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  firstName String
  lastName  String
  phone     String
  role      UserRole @default(RESTAURANT_OWNER)

  // 1. Relation Propriétaire
  ownedRestaurant Restaurant? @relation("RestaurantOwner")

  // 2. Relation Personnel (ancien lien direct)
  restaurantId String?
  restaurant   Restaurant? @relation("RestaurantStaff", fields: [restaurantId], references: [id])

  // 3. Membre d'équipe associé (profil staff dédié)
  teamMemberships TeamMember[]

  createdAt DateTime @default(now())

  @@map("users")
}

model Restaurant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  address      String
  city         String
  phone        String?
  email        String?
  subscription Subscription?
  logo         String?
  coverImage   String?
  openingHours String?
  isOpen       Boolean  @default(true)
  currency     String   @default("FCFA")
  deliveryFee  Int      @default(0)
  minOrder     Int      @default(0)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  category     String?
  cuisineType  String?

  // 1. Relation Propriétaire
  ownerId String @unique
  owner   User   @relation("RestaurantOwner", fields: [ownerId], references: [id])

  // 2. Relation Personnel (Utilisateurs direct)
  staff User[] @relation("RestaurantStaff")

  // 3. Relation Membres de l'Équipe (Gestion avancée du personnel)
  teamMembers TeamMember[]

  subscriptionPlan      SubscriptionPlan @default(FREE)
  subscriptionExpiresAt DateTime?
  createdAt             DateTime         @default(now())

  // Relations applicatives
  settings      RestaurantSettings?
  categories    Category[]
  dishes        Dish[]
  tables        RestaurantTable[]
  orders        Order[]
  reviews       Review[]
  coupons       Coupon[]
  subscriptions SubscriptionHistory[]
  notifications Notification[]

  @@map("restaurants")
}

// --- Membres de l'équipe du restaurant ---
model TeamMember {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Lien optionnel vers un compte utilisateur principal
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name        String?
  email       String?
  phone       String?
  role        StaffRole @default(WAITER)
  pinCode     String?   // Code PIN court (ex: 4 chiffres) pour connexion rapide Caisse/POS
  permissions String[]  @default([]) // Ex: ["VIEW_STATS", "MANAGE_MENU", "CANCEL_ORDERS"]
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([userId])
  @@map("team_members")
}

// --- Paramètres détaillés du restaurant ---
model RestaurantSettings {
  id                String     @id @default(cuid())
  restaurantId      String     @unique
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String     @default("Mon Restaurant")
  phone             String     @default("")
  address           String     @default("")
  currency          String     @default("FCFA")
  description       String?
  enableQrOrders    Boolean    @default(true)
  enableSoundAlerts Boolean    @default(true)
  notificationEmail String     @default("")
  notificationPhone String?
  serviceFeePercent Float      @default(0)
  wifiName          String?
  wifiPassword      String?
  openingHours      String?    @db.Text
  updatedAt         DateTime   @updatedAt

  @@map("restaurant_settings")
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  icon         String?
  order        Int        @default(0)
  active       Boolean    @default(true)
  dishes       Dish[]

  @@index([restaurantId])
  @@map("categories")
}

model Dish {
  id                 String            @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  description        String?
  price              Int
  originalPrice      Int?
  image              String?
  isAvailable        Boolean           @default(true)
  preparationTimeMin Int               @default(15)
  allergens          String[]          @default([])
  isPopular          Boolean           @default(false)
  isChefSpecial      Boolean           @default(false)
  isSpecialty        Boolean           @default(false)
  has3DModel         Boolean           @default(false)
  model3DType        Model3DType?
  createdAt          DateTime          @default(now())

  optionGroups DishOptionGroup[]
  reviews      Review[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@map("dishes")
}

// --- Groupes d'options / Variantes / Suppléments pour un plat ---
model DishOptionGroup {
  id           String       @id @default(cuid())
  dishId       String
  dish         Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name         String       // Ex: "Taille", "Choix de la sauce", "Suppléments"
  isRequired   Boolean      @default(false)
  minSelection Int          @default(0)
  maxSelection Int          @default(1)
  options      DishOption[]

  @@index([dishId])
  @@map("dish_option_groups")
}

model DishOption {
  id        String          @id @default(cuid())
  groupId   String
  group     DishOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String          // Ex: "Grand format", "Sauce Piment", "Extra Fromage"
  price     Int             @default(0)
  available Boolean         @default(true)

  @@index([groupId])
  @@map("dish_options")
}

model RestaurantTable {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       String
  name         String?
  capacity     Int        @default(4)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@map("restaurant_tables")
}

model Order {
  id              String        @id @default(cuid())
  trackingCode    String        @unique
  restaurantId    String
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantName  String
  restaurantPhone String?
  type            OrderType
  tableNumber     String?
  subtotal        Int
  deliveryFee     Int           @default(0)
  total           Int
  status          OrderStatus   @default(NEW)
  customerName    String
  customerPhone   String
  customerAddress String?
  customerNotes   String?
  couponCode      String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([restaurantId])
  @@map("orders")
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId   String?
  name     String
  price    Int
  quantity Int
  notes    String?
  image    String?
  options  Json?   // Stocke les options sélectionnées (ex: [{ name: "Extra Fromage", price: 500 }])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  timestamp DateTime    @default(now())
  note      String?

  @@index([orderId])
  @@map("order_status_history")
}

// --- Avis & Évaluations Clients ---
model Review {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId       String?
  dish         Dish?      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int        @default(5)
  comment      String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@map("reviews")
}

// --- Codes Promo / Réductions ---
model Coupon {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code         String
  discount     Int        // Montant ou pourcentage
  isPercentage Boolean    @default(false)
  minOrder     Int        @default(0)
  expiresAt    DateTime?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("coupons")
}

// --- Historique des Abonnements SaaS ---
model SubscriptionHistory {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan
  amount       Int
  status       String           @default("PAID") // PAID, PENDING, FAILED
  paymentRef   String?
  startDate    DateTime         @default(now())
  endDate      DateTime
  createdAt    DateTime         @default(now())

  @@index([restaurantId])
  @@map("subscription_history")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id           String             @id @default(cuid())
  restaurantId String             @unique
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  planId       String             // "STARTER", "PRO", "ENTERPRISE"
  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime           @default(now())
  endDate      DateTime
  autoRenew    Boolean            @default(true)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  invoices     Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount         Int
  currency       String       @default("FCFA")
  status         String       @default("PAID")
  description    String

  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@map("invoices")
}

// --- Notifications Internes ---
model Notification {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  message      String
  type         String?    // Ex: "NEW_ORDER", "LOW_STOCK", "SUBSCRIPTION"
  isRead       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@map("notifications")
}

// --- Marketing / Landing Page ---
model Testimonial {
  id             String   @id @default(cuid())
  name           String
  role           String
  restaurantName String?
  city           String
  avatar         String?
  rating         Int      @default(5)
  text           String
  createdAt      DateTime @default(now())

  @@map("testimonials")
}

model FAQItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String
  createdAt DateTime @default(now())

  @@map("faq_items")
}
